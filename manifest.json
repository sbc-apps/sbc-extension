{
  "manifest_version": 3,
  "name": "SBC Start: Your New Tab",
  "version": "1.5.2",
  "description": "A new tab with crypto prices, price alerts, converter, SBC news, weather, Jalali calendar, tasks, notes and a focus timer.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "search"
  ],
  "action": {
    "default_title": "SBC Start",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "start@sbc.om",
      "strict_min_version": "109.0"
    }
  }
}
